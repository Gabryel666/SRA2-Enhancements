<form class="sra2-config">

    {{! ─── 💰 ÉCONOMIE ─── }}
    <div class="sra2-config-section">
        <h3 class="sra2-section-heading">💰 Économie</h3>
        <p class="sra2-section-desc">Gestion des coûts en Cash et séparation XP/Cash sur les fiches.</p>

        <div class="sra2-setting-row">
            <label>{{localize "SRA2XPCash.Settings.EnableItemCashCost.Name"}}</label>
            <input type="checkbox" name="enableItemCashCost" {{checked settings.enableItemCashCost}} />
            <p class="sra2-hint">{{localize "SRA2XPCash.Settings.EnableItemCashCost.Hint"}}</p>
        </div>

        <h4 class="sra2-sub-heading">Types d'objets concernés</h4>

        <div class="sra2-setting-row"><label>Equipement</label><input type="checkbox" name="cashCostEquipment" {{checked settings.cashCostEquipment}} /></div>
        <div class="sra2-setting-row"><label>Armes</label><input type="checkbox" name="cashCostWeapon" {{checked settings.cashCostWeapon}} /></div>
        <div class="sra2-setting-row"><label>Armures</label><input type="checkbox" name="cashCostArmor" {{checked settings.cashCostArmor}} /></div>
        <div class="sra2-setting-row"><label>Cyberware</label><input type="checkbox" name="cashCostCyberware" {{checked settings.cashCostCyberware}} /></div>
        <div class="sra2-setting-row"><label>Cyberdeck</label><input type="checkbox" name="cashCostCyberdeck" {{checked settings.cashCostCyberdeck}} /></div>
        <div class="sra2-setting-row"><label>Véhicules</label><input type="checkbox" name="cashCostVehicle" {{checked settings.cashCostVehicle}} /></div>
    </div>

    {{! ─── 🔊 SONS ─── }}
    <div class="sra2-config-section">
        <h3 class="sra2-section-heading">🔊 Sons</h3>
        <p class="sra2-section-desc">Fichiers audio joués à l'ouverture et à la fermeture des fiches.</p>

        <div class="sra2-setting-row">
            <label>{{localize "SRA2XPCash.Settings.SheetOpenSound.Name"}}</label>
            <div class="sra2-filepicker-row">
                <input type="text" name="sheetOpenSound" value="{{settings.sheetOpenSound}}" placeholder="/sounds/..."/>
                <button type="button" class="sra2-fp-btn" data-target="sheetOpenSound" data-type="audio">📁</button>
            </div>
            <p class="sra2-hint">{{localize "SRA2XPCash.Settings.SheetOpenSound.Hint"}}</p>
        </div>

        <div class="sra2-setting-row">
            <label>{{localize "SRA2XPCash.Settings.SheetCloseSound.Name"}}</label>
            <div class="sra2-filepicker-row">
                <input type="text" name="sheetCloseSound" value="{{settings.sheetCloseSound}}" placeholder="/sounds/..."/>
                <button type="button" class="sra2-fp-btn" data-target="sheetCloseSound" data-type="audio">📁</button>
            </div>
            <p class="sra2-hint">{{localize "SRA2XPCash.Settings.SheetCloseSound.Hint"}}</p>
        </div>
    </div>

    {{! ─── 🖥️ INTERFACE ─── }}
    <div class="sra2-config-section">
        <h3 class="sra2-section-heading">🖥️ Interface</h3>
        <p class="sra2-section-desc">Personnalisation de l'interface Foundry — chat, sidebar, mesures.</p>

        <div class="sra2-setting-row">
            <label>{{localize "SRA2UI.Settings.HideDragMeasurement.Name"}}</label>
            <input type="checkbox" name="hideDragMeasurement" {{checked settings.hideDragMeasurement}} />
            <p class="sra2-hint">{{localize "SRA2UI.Settings.HideDragMeasurement.Hint"}}</p>
        </div>
        <div class="sra2-setting-row">
            <label>{{localize "SRA2UI.Settings.HideFormatBar.Name"}}</label>
            <input type="checkbox" name="hideFormatBar" {{checked settings.hideFormatBar}} />
            <p class="sra2-hint">{{localize "SRA2UI.Settings.HideFormatBar.Hint"}}</p>
        </div>
        <div class="sra2-setting-row">
            <label>{{localize "SRA2UI.Settings.ChatControlsBelow.Name"}}</label>
            <input type="checkbox" name="chatControlsBelow" {{checked settings.chatControlsBelow}} />
            <p class="sra2-hint">{{localize "SRA2UI.Settings.ChatControlsBelow.Hint"}}</p>
        </div>

        <h4 class="sra2-sub-heading">Barre latérale au démarrage</h4>

        <div class="sra2-setting-row">
            <label>{{localize "SRA2UI.Settings.SidebarExpandOnStart.Name"}}</label>
            <input type="checkbox" name="sidebarExpandOnStart" {{checked settings.sidebarExpandOnStart}} />
            <p class="sra2-hint">{{localize "SRA2UI.Settings.SidebarExpandOnStart.Hint"}}</p>
        </div>
        <div class="sra2-setting-row">
            <label>{{localize "SRA2UI.Settings.SidebarDefaultTab.Name"}}</label>
            <select name="sidebarDefaultTab">
                {{#select settings.sidebarDefaultTab}}
                <option value="chat">Chat</option>
                <option value="combat">Combat</option>
                <option value="scenes">Scènes</option>
                <option value="actors">Acteurs</option>
                <option value="items">Objets</option>
                <option value="journal">Journal</option>
                <option value="tables">Tables</option>
                <option value="cards">Objets plaçables</option>
                <option value="macros">Macros</option>
                <option value="playlists">Playlists</option>
                <option value="compendium">Compendium</option>
                <option value="settings">Paramètres</option>
                {{/select}}
            </select>
            <p class="sra2-hint">{{localize "SRA2UI.Settings.SidebarDefaultTab.Hint"}}</p>
        </div>

        <h4 class="sra2-sub-heading">Chat & Notifications</h4>

        <div class="sra2-setting-row">
            <label>{{localize "SRA2UI.Settings.HideChatPeek.Name"}}</label>
            <input type="checkbox" name="hideChatPeek" {{checked settings.hideChatPeek}} />
            <p class="sra2-hint">{{localize "SRA2UI.Settings.HideChatPeek.Hint"}}</p>
        </div>
        <div class="sra2-setting-row">
            <label>{{localize "SRA2UI.Settings.HotbarCollapsed.Name"}}</label>
            <input type="checkbox" name="hotbarCollapsed" {{checked settings.hotbarCollapsed}} />
            <p class="sra2-hint">{{localize "SRA2UI.Settings.HotbarCollapsed.Hint"}}</p>
        </div>
        <div class="sra2-setting-row">
            <label>{{localize "SRA2UI.Settings.AutoUnpauseGM.Name"}}</label>
            <input type="checkbox" name="autoUnpauseGM" {{checked settings.autoUnpauseGM}} />
            <p class="sra2-hint">{{localize "SRA2UI.Settings.AutoUnpauseGM.Hint"}}</p>
        </div>
    </div>

    {{! ─── 🙈 CACHER ─── }}
    <div class="sra2-config-section">
        <h3 class="sra2-section-heading">🙈 Cacher</h3>
        <p class="sra2-section-desc">Éléments d'interface à masquer. Idéal pour le broadcast ou l'affichage minimaliste.</p>

        <button type="button" class="sra2-collapse-btn" data-target="sra2-hide-panel">
            <span class="sra2-collapse-icon">▶</span> Afficher les éléments à masquer
        </button>

        <div class="sra2-hide-panel" id="sra2-hide-panel" style="display:none;">
            <h4 class="sra2-sub-heading">Éléments généraux</h4>

            <div class="sra2-setting-row"><label>{{localize "SRA2UI.Settings.HideNavComplete.Name"}}</label><input type="checkbox" name="hideNavComplete" {{checked settings.hideNavComplete}} /></div>
            <div class="sra2-setting-row"><label>{{localize "SRA2UI.Settings.HideControls.Name"}}</label><input type="checkbox" name="hideControls" {{checked settings.hideControls}} /></div>
            <div class="sra2-setting-row"><label>{{localize "SRA2UI.Settings.HideHotbar.Name"}}</label><input type="checkbox" name="hideHotbar" {{checked settings.hideHotbar}} /></div>
            <div class="sra2-setting-row"><label>{{localize "SRA2UI.Settings.HideLogo.Name"}}</label><input type="checkbox" name="hideLogo" {{checked settings.hideLogo}} /></div>
            <div class="sra2-setting-row"><label>{{localize "SRA2UI.Settings.HidePlayers.Name"}}</label><input type="checkbox" name="hidePlayers" {{checked settings.hidePlayers}} /></div>

            <h4 class="sra2-sub-heading">Onglets de la barre latérale</h4>
            <div class="sra2-grid-3col">
                <div class="sra2-setting-row"><label>Chat</label><input type="checkbox" name="hideTabChat" {{checked settings.hideTabChat}} /></div>
                <div class="sra2-setting-row"><label>Combat</label><input type="checkbox" name="hideTabCombat" {{checked settings.hideTabCombat}} /></div>
                <div class="sra2-setting-row"><label>Scènes</label><input type="checkbox" name="hideTabScenes" {{checked settings.hideTabScenes}} /></div>
                <div class="sra2-setting-row"><label>Acteurs</label><input type="checkbox" name="hideTabActors" {{checked settings.hideTabActors}} /></div>
                <div class="sra2-setting-row"><label>Objets</label><input type="checkbox" name="hideTabItems" {{checked settings.hideTabItems}} /></div>
                <div class="sra2-setting-row"><label>Journal</label><input type="checkbox" name="hideTabJournal" {{checked settings.hideTabJournal}} /></div>
                <div class="sra2-setting-row"><label>Tables</label><input type="checkbox" name="hideTabTables" {{checked settings.hideTabTables}} /></div>
                <div class="sra2-setting-row"><label>Objets plaçables</label><input type="checkbox" name="hideTabCards" {{checked settings.hideTabCards}} /></div>
                <div class="sra2-setting-row"><label>Macros</label><input type="checkbox" name="hideTabMacros" {{checked settings.hideTabMacros}} /></div>
                <div class="sra2-setting-row"><label>Playlists</label><input type="checkbox" name="hideTabPlaylists" {{checked settings.hideTabPlaylists}} /></div>
                <div class="sra2-setting-row"><label>Compendium</label><input type="checkbox" name="hideTabCompendium" {{checked settings.hideTabCompendium}} /></div>
                <div class="sra2-setting-row"><label>Paramètres</label><input type="checkbox" name="hideTabSettings" {{checked settings.hideTabSettings}} /></div>
            </div>
        </div>
    </div>

    <div class="sra2-config-footer">
        <button type="submit"><i class="fas fa-save"></i> Sauvegarder</button>
    </div>
</form>
